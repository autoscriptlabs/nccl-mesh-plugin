@@ -1333,6 +1333,20 @@ def init_distributed_environment(
             rank=rank,
             timeout=timeout,
         )
+        # Barrier + optional delay between torch.distributed init and NCCL
+        # communicator creation.  This gives the NCCL mesh plugin time to
+        # finish its own setup (handshake threads, RDMA resources, etc.)
+        # before any rank creates a PyNcclCommunicator.
+        torch.distributed.barrier()
+        nccl_init_delay = envs.VLLM_NCCL_INIT_DELAY
+        if nccl_init_delay > 0:
+            import time
+            logger.info(
+                "VLLM_NCCL_INIT_DELAY=%.2fs: waiting after "
+                "torch.distributed init before NCCL communicator creation",
+                nccl_init_delay,
+            )
+            time.sleep(nccl_init_delay)
     # set the local rank
     # local_rank is not available in torch ProcessGroup,
     # see https://github.com/pytorch/pytorch/issues/122816
